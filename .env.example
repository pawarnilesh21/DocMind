# Copy to .env.local-review for Docker review. The existing .env is not migrated automatically.
# Use a long random hexadecimal password here; URL-reserved characters require encoding.
POSTGRES_PASSWORD=replace_with_a_long_random_hex_password
GEMINI_API_KEY=replace_with_your_key
GROQ_API_KEY=replace_with_your_key
ENVIRONMENT=development
DEBUG=false
COOKIE_SECURE=false
JWT_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_bytes
JWT_ISSUER=docmind
JWT_AUDIENCE=docmind-web
ALLOWED_ORIGINS=["http://localhost:8080","http://localhost:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
# For running Python directly against your own pgvector database:
DATABASE_URL=postgresql://docmind:password@localhost:5432/docmind
LLM_MODEL=qwen/qwen3.8-27b
EMBEDDING_MODEL=gemini-embedding-001
